{
  "manifestVersion": 5,
  "id": "com.frameflash.gifbooth",
  "name": "FrameFlash GIF Booth",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "frameflashPanel",
      "label": {
        "default": "FrameFlash Booth"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 380,
        "height": 620
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  }
}
